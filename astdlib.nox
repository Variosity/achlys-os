// ---------------------------------------------------------
// 🛡️ ASTDLIB - Achlys Bare-Metal Standard Library (Ring 0)
// ---------------------------------------------------------

// --- 1. THE KERNEL HEAP (Memory Manager) ---
communis kernel_heap : int -> 0x1000000^ 

opus malloc(size) {
    // [THE GHOST IS DEAD] Force 16-byte physical memory alignment BEFORE allocating!
    // This prevents the E1000 DMA Controller from silently truncating packet pointers.
    vas rem : int -> kernel_heap % 16^
    si (rem > 0) {
        kernel_heap -> ptr_add(kernel_heap, 16 - rem)^
    }

    vas allocated_ptr : int -> kernel_heap^
    kernel_heap -> ptr_add(kernel_heap, size)^ 
    
    reddo allocated_ptr^
}
opus realloc(ptr, size) {
    vas new_ptr : int -> malloc(size)^
    
    // If this isn't a brand new allocation (ptr > 0), copy the old data over!
    si (ptr > 0) {
        vas old_size : int -> size - 8^ // Arrays always grow by exactly 8 bytes
        vas i : int -> 0^
        
        // Native Ring-0 Memcopy
        dum (i < old_size) {
            vas b : int -> scrutari(ptr_add(ptr, i))^ // Read 1 byte from old RAM
            mutare_mem(ptr_add(new_ptr, i), b)^       // Write 1 byte to new RAM
            i -> i + 1^
        }
    }
    
    reddo new_ptr^
}


// --- 2. VGA VIDEO DRIVER (Hardware Display) ---
// The VGA text buffer lives at physical memory address 0xB8000

// --- 2. VESA GRAPHICS COMPOSITOR (The Visual Cortex) ---

communis FB_ADDR : int -> 0^
communis BACK_BUFFER : int -> 0^ // [NEW] The Invisible Fast-RAM Canvas
communis FB_PITCH : int -> 0^
communis FB_WIDTH : int -> 0^
communis FB_HEIGHT : int -> 0^

opus read_32(addr) {
    vas b0 : int -> scrutari(addr)^
    vas b1 : int -> scrutari(ptr_add(addr, 1))^
    vas b2 : int -> scrutari(ptr_add(addr, 2))^
    vas b3 : int -> scrutari(ptr_add(addr, 3))^
    reddo b0 | (b1 <<< 8) | (b2 <<< 16) | (b3 <<< 24)^
}

opus init_graphics() {
    FB_ADDR -> read_32(0x5000)^
    FB_PITCH -> read_32(0x5004)^
    FB_WIDTH -> read_32(0x5008)^
    FB_HEIGHT -> read_32(0x500C)^
    
    // Allocate the Back Buffer dynamically based on resolution
    BACK_BUFFER -> malloc(FB_HEIGHT * FB_PITCH)^
}

opus put_pixel(x, y, r, g, b) {
    si (x >= 0 et x < FB_WIDTH et y >= 0 et y < FB_HEIGHT) {
        vas offset : int -> ptr_add(y * FB_PITCH, x * 4)^
        
        // [FIX] Draw to the fast BACK_BUFFER instead of the slow graphics card
        vas addr : int -> ptr_add(BACK_BUFFER, offset)^ 
        
        mutare_mem(addr, b)^               
        mutare_mem(ptr_add(addr, 1), g)^   
        mutare_mem(ptr_add(addr, 2), r)^   
    }
}

// [NEW] Blast the hidden RAM buffer to the physical monitor instantly
opus swap_buffers() {
    fast_memcpy(FB_ADDR, BACK_BUFFER, FB_HEIGHT * FB_PITCH)^
}


// --- Absolute Value Helper ---
opus abs(n) { 
    si (n < 0) { reddo 0 - n^ } 
    reddo n^ 
}

// --- BRESENHAM'S LINE ALGORITHM ---
// Draws a hardware-accelerated 1-pixel diagonal line between any two points
opus draw_line(x0, y0, x1, y1, r, g, b) {
    vas dx : int -> abs(x1 - x0)^
    vas dy : int -> 0 - abs(y1 - y0)^
    
    vas sx : int -> -1^ si (x0 < x1) { sx -> 1^ }
    vas sy : int -> -1^ si (y0 < y1) { sy -> 1^ }
    
    vas err : int -> dx + dy^
    vas running : int -> 1^
    
    dum (running) {
        // Safety clipping: Only draw if pixel is physically on the monitor
        si (x0 >= 0 et x0 < FB_WIDTH et y0 >= 0 et y0 < FB_HEIGHT) {
            put_pixel(x0, y0, r, g, b)^
        }
        
        si (x0 == x1 et y0 == y1) { running -> 0^ }
        
        si (running) {
            vas e2 : int -> 2 * err^
            si (e2 >= dy) {
                err -> err + dy^
                x0 -> x0 + sx^
            }
            si (e2 <= dx) {
                err -> err + dx^
                y0 -> y0 + sy^
            }
        }
    }
}

// Draw a solid rectangle
// HARDWARE ACCELERATED RECTANGLE DRAWING
opus draw_rect(x, y, w, h, r, g, b) {
    // Pack RGB bytes into a single 32-bit Little-Endian Hex Color
    vas color : int -> b | (g <<< 8) | (r <<< 16)^
    
    // Safety Canvas Bounds Clipping
    vas start_x : int -> x^ si (start_x < 0) { start_x -> 0^ }
    vas start_y : int -> y^ si (start_y < 0) { start_y -> 0^ }
    vas end_x : int -> x + w^ si (end_x > FB_WIDTH) { end_x -> FB_WIDTH^ }
    vas end_y : int -> y + h^ si (end_y > FB_HEIGHT) { end_y -> FB_HEIGHT^ }
    
    vas draw_w : int -> end_x - start_x^
    vas draw_h : int -> end_y - start_y^
    
    si (draw_w > 0 et draw_h > 0) {
        vas j : int -> 0^
        // We only loop the Y-axis now. The X-axis is done in hardware!
        dum (j < draw_h) {
            vas current_y : int -> start_y + j^
            vas offset : int -> ptr_add(current_y * FB_PITCH, start_x * 4)^
            vas row_addr : int -> ptr_add(BACK_BUFFER, offset)^
            
            // BLAST THE ENTIRE ROW IN 1 INSTRUCTION
            fast_fill32(row_addr, color, draw_w)^
            
            j -> j + 1^
        }
    }
}

// Draw a glowing, borderless Node on the Canvas
opus draw_node(x, y, w, h, r, g, b) {
    // Fill inner background (Dark Void)
    draw_rect(x, y, w, h, 15, 15, 18)^
    
    // Draw outer glowing neon borders
    vas t : int -> 2^ // Thickness
    draw_rect(x, y, w, t, r, g, b)^ // Top
    draw_rect(x, y + h - t, w, t, r, g, b)^ // Bottom
    draw_rect(x, y, t, h, r, g, b)^ // Left
    draw_rect(x + w - t, y, t, h, r, g, b)^ // Right
}

// Render the Infinite Canvas Background
opus draw_canvas_gradient() {
    vas y : int -> 0^
    dum (y < FB_HEIGHT) {
        vas x : int -> 0^
        vas b_val : int -> (y * 255) / FB_HEIGHT^
        dum (x < FB_WIDTH) {
            vas r_val : int -> (x * 255) / FB_WIDTH^
            // A deep, cyberpunk purple/blue gradient
            put_pixel(x, y, r_val / 3, 5, b_val / 2)^
            x -> x + 1^
        }
        y -> y + 1^
    }
}

// --- 3. HARDWARE KEYBOARD DRIVER (PS/2) ---

opus get_scancode() {
    // Read the status register (Port 0x64)
    vas status : int -> port_in(0x64)^
    
    // Check if Bit 0 is 1 (Output Buffer Full / Data Ready)
    vas is_ready : int -> status & 1^
    
    si (is_ready) {
        // Read the actual key scancode from the Data Register (Port 0x60)
        reddo port_in(0x60)^
    }
    
    // Return 0 if no key was pressed
    reddo 0^
}

// --- 4. UTILITIES ---
opus int_to_str(n) {
    si (n == 0) { reddo "0"^ }
    vas out : str -> ""^
    vas is_neg : int -> 0^
    si (n < 0) { is_neg -> 1^ n -> 0 - n^ }
    dum (n > 0) {
        vas digit : int -> n % 10^
        vas c : int -> 48 + digit^
        out -> signum_ex(c) + out^
        n -> n / 10^
    }
    si (is_neg) { out -> "-" + out^ }
    reddo out^
}

// --- 5. KEYBOARD MAP & TRANSLATOR ---
// Maps PS/2 Scancodes (Set 1) to ASCII Strings
communis kbd_map : arr -> [
    "", "ESC", "1", "2", "3", "4", "5", "6", "7", "8", "9", "0", "-", "=", "BACKSPACE",
    "TAB", "q", "w", "e", "r", "t", "y", "u", "i", "o", "p", "[", "]", "ENTER",
    "CTRL", "a", "s", "d", "f", "g", "h", "j", "k", "l", ";", "'", "`", "LSHIFT",
    "\\", "z", "x", "c", "v", "b", "n", "m", ",", ".", "/", "RSHIFT", "*",
    "ALT", " "
]^

communis shift_map : arr -> [
    "", "ESC", "!", "@", "#", "$", "%", "^", "&", "*", "(", ")", "_", "+", "BACKSPACE",
    "TAB", "Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P", "{", "}", "ENTER",
    "CTRL", "A", "S", "D", "F", "G", "H", "J", "K", "L", ":", "\"", "~", "LSHIFT",
    "|", "Z", "X", "C", "V", "B", "N", "M", "<", ">", "?", "RSHIFT", "*",
    "ALT", " "
]^

opus get_char_from_code(code) {
    si (code >= 0 et code <= 57) {
        reddo kbd_map[code]^
    }
    reddo ""^
}

